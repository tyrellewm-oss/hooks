  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "litesvm": "^0.8.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
