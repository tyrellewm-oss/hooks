# Hookd local settings, read by start-hookd.cmd (scripts/start.mjs). It is copied to .env on first run. .env is
# gitignored, so it is never committed; if this folder is synced (OneDrive, Dropbox) it is uploaded there too.
# Leave a line empty to use its default.

# auto = live devnet data when the admin key is on this PC, else sample data. Or: live, demo, preview.
HOOKD_MODE=auto

# A private devnet RPC URL (a free Helius devnet key works). Empty = .devnet-keys\helius_rpc.txt if it exists,
# else the public devnet RPC, which rate-limits token pages. Never a mainnet URL.
DEVNET_RPC=

# Folder holding deployer.json and launch.json, as a full path outside the repo (no ~).
# Empty = the .devnet-keys folder in the repo.
DEVNET_KEY_DIR=

# Your wallet address(es), comma-separated, to sign in to the studio and launch tokens. Empty = studio closed.
STUDIO_WALLETS=

# on = pull the branch you are on from GitHub every 30 s and reload the page (backend restarts when its code changes).
HOOKD_FOLLOW=on

# on = run the trade indexer, which fills the price charts and trade lists.
HOOKD_INDEXER=on

# on = open the browser when everything is up.
HOOKD_OPEN_BROWSER=on
